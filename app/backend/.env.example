# Copy to .env and set your real keys. NEVER commit .env to source control.

# ─── OpenAI (for ResQBot AI chatbot) ───
OPENAI_API_KEY=your_openai_api_key_here
# Optional: override model (default: gpt-3.5-turbo)
OPENAI_MODEL=gpt-3.5-turbo

# ─── MongoDB ───
# Use your MongoDB Atlas SRV URI or a local MongoDB URI
# Falls back to JSON files in backend/data/ if unreachable
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/resqtail?retryWrites=true&w=majority&appName=resqtail-cluster

# ─── Razorpay (for donations) ───
RZP_KEY_ID=rzp_test_your_key_id
RZP_KEY_SECRET=rzp_test_your_key_secret

# ─── Brevo SMTP for email notifications ───
# Sign up at https://brevo.com → SMTP & API → generate SMTP key
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email
SMTP_PASS=xsmtpsib-your_smtp_key_here
SMTP_SECURE=false
SMTP_FROM=noreply@resqtail.org
REPORT_NOTIFY_EMAIL=admin@resqtail.org

# ─── CORS (optional) ───
ALLOWED_ORIGINS=

# ─── Rate limiting overrides ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
RATE_LIMIT_CHAT_WINDOW_MS=60000
RATE_LIMIT_CHAT_MAX=10

# ─── Server ───
PORT=5000

# ─── Cloudinary (for image uploads) ───
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
