    <div style="background:rgba(151,244,217,0.08);border:1px solid rgba(151,244,217,0.15);border-radius:var(--radius);padding:12px 18px;margin-bottom:28px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
