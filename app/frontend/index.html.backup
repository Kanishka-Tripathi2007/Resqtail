        <div class="vol-ngo-item"><div><strong>People for Animals (PFA) – Pan India</strong><span>Medical Camps · Rescue · 25+ Chapters Across India</span></div><button class="ngo-btn-upi" onclick="window.open('https://www.pfaindia.com/volunteer','_blank')">🌐 Apply Online</button></div>
        <div class="vol-ngo-item"><div><strong>Friendicoes SECA – Delhi</strong><span>Rescue · Adoption Coordination · Shelter Management</span></div><button class="ngo-btn-upi" onclick="window.open('mailto:friendicoes@gmail.com?subject=Volunteer Application&body=Hi! I would like to volunteer with Friendicoes.')">✉️ Apply via Email</button></div>
        <div class="vol-ngo-item"><div><strong>Wildlife SOS – Pan India</strong><span>Wildlife Rescue · Research · Education Outreach</span></div><button class="ngo-btn-upi" onclick="window.open('https://wildlifesos.org/volunteer','_blank')">🌐 Apply Online</button></div>
