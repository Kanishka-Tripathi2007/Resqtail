<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ResQtail — Every Life Matters | Emergency Animal Rescue Platform</title>
<meta name="description" content="ResQtail connects you with nearby vets, NGOs, shelters and rescuers across India. Report, rescue, adopt, donate, and get emergency animal help instantly.">
<meta name="theme-color" content="#0D7C66">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,600;0,900;1,300;1,600&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="styles.css">
</head>
<body>

<!-- Skip to content for accessibility -->
<a href="#hero" class="skip-link">Skip to main content</a>

<!-- Weather Alert Banner -->
<div class="weather-banner" id="weatherBanner" role="alert">
  🌡️ Heatwave Alert in your area — Please keep water bowls outside for street animals today!
  <button class="close-banner" onclick="document.getElementById('weatherBanner').style.display='none'" aria-label="Close weather alert">✕</button>
</div>

<!-- NAV -->
<nav role="navigation" aria-label="Main navigation">
  <div class="nav-logo">🐾 ResQ<span>tail</span></div>
  <div class="nav-links">
    <a href="#sos">SOS</a>
    <a href="#nearby">Nearby Help</a>
    <a href="#findbrowser">🔍 Find Nearby</a>
    <a href="#firstaid">First Aid</a>
    <a href="#rescue">Rescue</a>
    <a href="#feeding">Feeding</a>
    <a href="#donate">Donate</a>
    <a href="#report">Report</a>
  </div>
  <button class="nav-sos" onclick="scrollToSection('sos')" aria-label="Go to emergency SOS section">🆘 Emergency</button>
</nav>

<!-- HERO -->
<section id="hero" role="banner">
  <div class="hero-bg-paws"></div>
  <div class="hero-blob"></div>
  <div class="hero-content">
    <div class="hero-badge">🐾 India's Street Animal Safety Platform</div>
    <h1>Every life on<br>the <em>street</em><br>matters.</h1>
    <p class="hero-sub">Report, rescue, adopt, donate, and get emergency animal help across India. ResQtail connects you with vets, NGOs, and rescuers — right when it matters most.</p>
    <div class="hero-ctas">
      <button class="btn-emergency" onclick="scrollToSection('sos')" aria-label="Emergency SOS - Go to emergency section">🆘 Emergency SOS</button>
      <button class="btn-secondary" onclick="scrollToSection('nearby')" aria-label="Find nearby help">🏥 Find Help Nearby</button>
    </div>

    <!-- Quick Action Cards -->
    <div class="quick-actions" role="navigation" aria-label="Quick actions">
      <a href="#report" class="quick-action-card" aria-label="Report an injured animal">
        <span class="qa-icon">📢</span>
        <span class="qa-label">Report Animal</span>
      </a>
      <a href="#nearby" class="quick-action-card" aria-label="Find nearby vet">
        <span class="qa-icon">🏥</span>
        <span class="qa-label">Nearby Vet</span>
      </a>
      <a href="#donate" class="quick-action-card" aria-label="Donate to help animals">
        <span class="qa-icon">💚</span>
        <span class="qa-label">Donate</span>
      </a>
      <a href="#rescue" class="quick-action-card" aria-label="Adopt an animal">
        <span class="qa-icon">🏠</span>
        <span class="qa-label">Adopt</span>
      </a>
      <a href="#firstaid" class="quick-action-card" aria-label="First aid guide">
        <span class="qa-icon">🩹</span>
        <span class="qa-label">First Aid</span>
      </a>
      <div class="quick-action-card" onclick="toggleChat()" role="button" tabindex="0" aria-label="Open ResQBot AI assistant">
        <span class="qa-icon">🤖</span>
        <span class="qa-label">ResQBot AI</span>
      </div>
    </div>

    <div class="hero-animals" aria-hidden="true">
      <span>🐶</span><span>🐱</span><span>🐮</span><span>🐦</span><span>🐒</span>
    </div>
  </div>

  <!-- Trust Section -->
  <div class="trust-section" style="position:absolute;bottom:40px;left:0;right:0;max-width:1200px;margin:0 auto;padding:0 40px;">
    <div class="trust-item">
      <div class="trust-icon">📍</div>
      <h4>GPS-Enabled Rescue</h4>
      <p>Auto-detect your location to find the nearest help instantly</p>
    </div>
    <div class="trust-item">
      <div class="trust-icon">✅</div>
      <h4>Verified Help Network</h4>
      <p>Real NGOs, vets and shelters verified across India</p>
    </div>
    <div class="trust-item">
      <div class="trust-icon">🔒</div>
      <h4>Secure Donations</h4>
      <p>Razorpay-powered payments with receipt confirmation</p>
    </div>
    <div class="trust-item">
      <div class="trust-icon">🤖</div>
      <h4>AI First-Aid Guidance</h4>
      <p>Get instant animal care advice from our AI assistant</p>
    </div>
  </div>
</section>

  <!-- LISTING MODAL -->
  <div class="modal-overlay" id="listingModal">
    <div class="modal">
      <h3>📸 Create Adoption Listing</h3>
      <div style="display:flex;flex-direction:column;gap:8px;">
        <input id="listingName" placeholder="Pet name (required)" aria-label="Pet name" />
        <select id="listingType" aria-label="Species"><option value="">Species *</option><option>Dog</option><option>Cat</option><option>Bird</option><option>Cow</option><option>Other</option></select>
        <input id="listingBreed" placeholder="Breed (e.g. Indie, Persian, Labrador)" aria-label="Breed" />
        <input id="listingAge" placeholder="Age (e.g. ~2 years)" aria-label="Age" />
        <select id="listingSex" aria-label="Sex"><option value="">Sex</option><option>Male</option><option>Female</option><option>Unknown</option></select>
        <select id="listingVaccination" aria-label="Vaccination status"><option value="Unknown">Vaccination Status</option><option>Vaccinated</option><option>Not Vaccinated</option><option>Partially Vaccinated</option></select>
        <input id="listingShelter" placeholder="Shelter name (if any)" aria-label="Shelter name" />
        <input id="listingLocation" placeholder="City / Area" aria-label="Location" />
        <select id="listingListerType" aria-label="Listed by"><option value="Individual">Listed by</option><option>Individual</option><option>Shelter</option><option>Pet Shop</option></select>
        <textarea id="listingDesc" placeholder="Short description — personality, health, behavior..." aria-label="Description"></textarea>
        <input id="listingContact" placeholder="Contact phone / email" aria-label="Contact information" />
        <input id="listingPhotos" type="file" accept="image/*" multiple aria-label="Upload photos" />
        <div style="display:flex;gap:8px;">
          <button class="submit-btn" onclick="submitListing()">Publish</button>
          <button class="modal-close" onclick="closeListingModal()">Cancel</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ADOPTION INQUIRY MODAL -->
  <div class="modal-overlay" id="inquiryModal">
    <div class="modal">
      <h3>🐾 Adoption Inquiry</h3>
      <div style="display:flex;flex-direction:column;gap:8px;">
        <input type="hidden" id="inquiryListingId" />
        <p id="inquiryPetName" style="font-weight:700;color:var(--primary-dark);margin-bottom:4px;"></p>
        <input id="inquiryName" placeholder="Your Name *" aria-label="Your name" />
        <input id="inquiryEmail" type="email" placeholder="Your Email *" aria-label="Your email" />
        <input id="inquiryPhone" placeholder="Phone (optional)" aria-label="Phone number" />
        <textarea id="inquiryMessage" placeholder="Tell us why you'd like to adopt and about your home setup..." aria-label="Message"></textarea>
        <div style="display:flex;gap:8px;">
          <button class="submit-btn" onclick="submitInquiry()">Send Inquiry</button>
          <button class="modal-close" onclick="closeInquiryModal()">Cancel</button>
        </div>
      </div>
    </div>
  </div>

<!-- SOS -->
<section id="sos" aria-label="Emergency SOS">
  <div class="container reveal">
    <div class="sos-grid">
      <div>
        <div class="section-label">🚨 Emergency</div>
        <h2>One tap. Instant help.</h2>
        <p class="section-sub" style="color:rgba(255,255,255,0.5)">Animal in danger? Don't wait. Press SOS and we'll auto-detect your location and connect you to the nearest help.</p>
        <button class="sos-main-btn" onclick="triggerSOS()" aria-label="Press SOS to activate emergency alert">
          🆘 PRESS SOS NOW
        </button>
        <p class="sos-microcopy">⚠️ Use only for urgent animal rescue situations</p>
        <div class="gps-status" id="gpsStatus" aria-live="polite">
          <span>📍</span> GPS: Waiting for activation
        </div>
        <div class="sos-cards">
          <div class="sos-card" onclick="callNumber('1962')" role="button" tabindex="0" aria-label="Call Animal Welfare Board">
            <div class="icon">📞</div>
            <h4>Call NGO</h4>
            <p>Connect instantly</p>
          </div>
          <div class="sos-card" onclick="whatsappShare()" role="button" tabindex="0" aria-label="Share location via WhatsApp">
            <div class="icon">💬</div>
            <h4>WhatsApp</h4>
            <p>Share location</p>
          </div>
          <div class="sos-card" onclick="shareLocation()" role="button" tabindex="0" aria-label="Copy live GPS location">
            <div class="icon">📍</div>
            <h4>Share Location</h4>
            <p>Live GPS link</p>
          </div>
          <div class="sos-card" onclick="callNumber('1800111565')" role="button" tabindex="0" aria-label="Call Animal Ambulance">
            <div class="icon">🚑</div>
            <h4>Animal Ambulance</h4>
            <p>Emergency transport</p>
          </div>
        </div>
      </div>
      <div class="sos-info">
        <p>🇮🇳 National & State Helplines</p>
        <div class="hotlines">
          <div class="hotline-item" style="border:1px solid rgba(151,244,217,0.15);">
            <div>
              <div class="name">Go Nirvana Foundation – Jaipur</div>
              <div style="font-size:0.73rem;color:rgba(255,255,255,0.4)">Patrakar Colony · 24×7 Emergency</div>
            </div>
            <div class="number">+91 7851-032328</div>
            <button class="call-btn" onclick="callNumber('7851032328')" aria-label="Call Go Nirvana Foundation">Call</button>
          </div>
          <div class="hotline-item" style="border:1px solid rgba(151,244,217,0.15);">
            <div>
              <div class="name">Jaipur Animal Welfare Association</div>
              <div style="font-size:0.73rem;color:rgba(255,255,255,0.4)">Kalwar Road · 10AM–6PM</div>
            </div>
            <div class="number">9983904242</div>
            <button class="call-btn" onclick="callNumber('9983904242')" aria-label="Call JAWA">Call</button>
          </div>
          <div class="hotline-item">
            <div>
              <div class="name">Animal Welfare Board of India</div>
            </div>
            <div class="number">1962</div>
            <button class="call-btn" onclick="callNumber('1962')" aria-label="Call AWBI">Call</button>
          </div>
          <div class="hotline-item">
            <div>
              <div class="name">PFA India Helpline</div>
            </div>
            <div class="number">1800-111-565</div>
            <button class="call-btn" onclick="callNumber('1800111565')" aria-label="Call PFA">Call</button>
          </div>
          <div class="hotline-item">
            <div>
              <div class="name">Friendicoes – Delhi</div>
            </div>
            <div class="number">011-2461-1139</div>
            <button class="call-btn" onclick="callNumber('01124611139')" aria-label="Call Friendicoes">Call</button>
          </div>
          <div class="hotline-item">
            <div>
              <div class="name">Blue Cross – Chennai</div>
            </div>
            <div class="number">044-2235-1550</div>
            <button class="call-btn" onclick="callNumber('04422351550')" aria-label="Call Blue Cross">Call</button>
          </div>
          <div class="hotline-item">
            <div>
              <div class="name">SPCA – Mumbai</div>
            </div>
            <div class="number">022-2307-8036</div>
            <button class="call-btn" onclick="callNumber('02223078036')" aria-label="Call SPCA">Call</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- NEARBY HELP -->
<section id="nearby" aria-label="Find nearby help">
  <div class="container reveal">
    <div class="section-label">🏥 Find Help</div>
    <h2>Nearby Vets & Shelters</h2>
    <p class="section-sub">Filter by animal type and find clinics, shelters, NGOs, and ambulance services near you.</p>

    <div class="map-placeholder" id="mapPlaceholder">
      <div class="map-pin">📍</div>
      <p id="locStatusText">Live Location Map</p>
      <small id="locStatusDetail" style="margin-bottom: 4px">Enable location access to pull actual vets and shelters near you</small>
      <div id="locAccuracyBar" style="display:none;position:relative;z-index:2;font-size:0.75rem;color:var(--primary);font-weight:600;margin-bottom:4px;"></div>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:center;margin-top:8px;position:relative;z-index:2;">
        <label for="radiusSelect" style="font-size:0.85rem;color:var(--text-muted);margin-right:6px;">Radius</label>
        <select id="radiusSelect" onchange="onRadiusChange()" aria-label="Search radius" style="padding:8px 12px;border-radius:var(--radius);border:1.5px solid var(--surface-dim);font-weight:600;font-family:var(--font);cursor:pointer;background:var(--surface);">
          <option value="5000">5 km</option>
          <option value="10000" selected>10 km</option>
          <option value="25000">25 km</option>
          <option value="50000">50 km</option>
        </select>
        <button onclick="detectLocationAndFetchLive()" id="liveDataBtn" style="background:var(--primary); color:white; border:none; padding:10px 22px; border-radius:var(--radius-full); font-weight:700; cursor:pointer; transition: all 0.3s; display:flex; align-items:center; gap:6px; font-family:var(--font);" aria-label="Scan area for nearby helpers">🛰️ Scan Area for Helpers</button>
        <button onclick="stopLocationWatch()" id="stopWatchBtn" style="display:none;background:var(--emergency);color:white;border:none;padding:8px 16px;border-radius:var(--radius-full);font-weight:600;cursor:pointer;font-size:0.82rem;font-family:var(--font);" aria-label="Stop location tracking">⏹ Stop Tracking</button>
      </div>
    </div>

    <div class="animal-selector" id="animalSelector" role="radiogroup" aria-label="Filter by animal type">
      <button class="animal-btn active" data-animal="all" onclick="filterAnimal('all', this)" role="radio" aria-checked="true">🐾 All Animals</button>
      <button class="animal-btn" data-animal="dog" onclick="filterAnimal('dog', this)" role="radio" aria-checked="false">🐶 Dog</button>
      <button class="animal-btn" data-animal="cat" onclick="filterAnimal('cat', this)" role="radio" aria-checked="false">🐱 Cat</button>
      <button class="animal-btn" data-animal="cow" onclick="filterAnimal('cow', this)" role="radio" aria-checked="false">🐮 Cow</button>
      <button class="animal-btn" data-animal="bird" onclick="filterAnimal('bird', this)" role="radio" aria-checked="false">🐦 Bird</button>
      <button class="animal-btn" data-animal="other" onclick="filterAnimal('other', this)" role="radio" aria-checked="false">🐒 Other</button>
    </div>

    <div class="nearby-grid" id="nearbyGrid"></div>
  </div>
</section>

<!-- FIND NEARBY BROWSER -->
<section id="findbrowser" aria-label="Search and discover animal services">
  <div class="container reveal">
    <div class="section-label">🔍 Search & Discover</div>
    <h2>Find NGOs, Vets & Animal Hospitals</h2>
    <p class="section-sub">Search for animal care services near your area — NGOs, veterinary clinics, animal hospitals, and rescue shelters across India.</p>

    <div class="browser-box">
      <div class="browser-search-bar">
        <input class="browser-search-input" id="browserSearchInput" placeholder="e.g. animal hospital, NGO, vet clinic..." onkeydown="if(event.key==='Enter') runBrowserSearch()" aria-label="Search for animal care services" />
        <button class="browser-loc-btn" onclick="autoFillLocation()" aria-label="Use my location">📍 My Location</button>
        <button class="browser-search-btn" onclick="runBrowserSearch()" aria-label="Search">🔍 Search</button>
      </div>

      <div class="browser-chips" role="group" aria-label="Quick search categories">
        <span class="browser-chip active" onclick="setChip(this,'animal NGO near me')" role="button" tabindex="0">🏛️ NGOs</span>
        <span class="browser-chip" onclick="setChip(this,'veterinary clinic near me')" role="button" tabindex="0">🩺 Vets</span>
        <span class="browser-chip" onclick="setChip(this,'animal hospital near me')" role="button" tabindex="0">🏥 Animal Hospitals</span>
        <span class="browser-chip" onclick="setChip(this,'animal shelter near me')" role="button" tabindex="0">🏠 Shelters</span>
        <span class="browser-chip" onclick="setChip(this,'animal rescue NGO near me')" role="button" tabindex="0">🚑 Rescue</span>
        <span class="browser-chip" onclick="setChip(this,'pet emergency vet near me')" role="button" tabindex="0">🆘 Emergency Vet</span>
      </div>

      <div class="browser-status" id="browserStatus">
        Enter a search above or pick a category to find animal care services near you. 🐾
      </div>
      <div class="browser-results" id="browserResults"></div>
    </div>
  </div>
</section>

<!-- FIRST AID -->
<section id="firstaid" aria-label="Emergency first aid guide">
  <div class="container reveal">
    <div class="section-label">🩹 First Aid</div>
    <h2>Emergency First Aid Guide</h2>
    <p class="section-sub">Simple steps to stabilize a street animal before professional help arrives. Always contact a vet or NGO after first aid.</p>

    <div class="firstaid-grid" id="firstaidGrid"></div>

    <div class="disclaimer-box" role="alert">
      <div class="icon">⚠️</div>
      <p><strong>Important Disclaimer:</strong> All first aid information provided here is temporary and educational only. First aid is never a replacement for professional veterinary care. Always contact a licensed vet or animal NGO immediately after providing first aid. Incorrect handling can worsen injuries.</p>
    </div>
  </div>
</section>

<!-- RESCUE & ADOPTION -->
<section id="rescue" aria-label="Rescue guide and adoption">
  <div class="container reveal">
    <div class="section-label">🏠 Rescue & Adoption</div>
    <h2>Save a life. Give a home.</h2>
    <p class="section-sub">Learn how to safely rescue an injured street animal, or open your heart and home to one looking for a family.</p>

    <div class="rescue-tabs" role="tablist">
      <button class="rescue-tab active" onclick="switchRescueTab('rescue-steps', this)" role="tab" aria-selected="true">🐾 Rescue Guide</button>
      <button class="rescue-tab" onclick="switchRescueTab('adoption', this)" role="tab" aria-selected="false">❤️ Adopt an Animal</button>
    </div>

    <div class="rescue-content active" id="rescue-steps" role="tabpanel">
      <div class="rescue-steps">
        <div class="rescue-step">
          <div class="step-num-big">01</div>
          <h4>Assess the Situation</h4>
          <p>Stay calm. Don't rush toward the animal. Assess injury level — is it conscious, breathing, bleeding severely? Note the location details.</p>
        </div>
        <div class="rescue-step">
          <div class="step-num-big">02</div>
          <h4>Call for Professional Help</h4>
          <p>Call the nearest shelter or NGO BEFORE attempting to move the animal. Describe the injury and location clearly. They will guide you.</p>
        </div>
        <div class="rescue-step">
          <div class="step-num-big">03</div>
          <h4>Provide Immediate Safety</h4>
          <p>If safe to do so, keep the animal away from traffic. Use a cardboard box or soft cloth. Avoid sudden movements that may startle it.</p>
        </div>
        <div class="rescue-step">
          <div class="step-num-big">04</div>
          <h4>Safe Transport</h4>
          <p>Use a box or blanket as a makeshift stretcher. Support the full body. Keep the animal warm and dark. Drive smoothly and slowly to the vet.</p>
        </div>
        <div class="rescue-step">
          <div class="step-num-big">05</div>
          <h4>Hand Over to Professionals</h4>
          <p>Provide all information to the vet — where you found it, estimated age, visible injuries. Follow up if possible to know its status.</p>
        </div>
      </div>
      <div class="dont-list">
        <h4>❌ What NOT to Do</h4>
        <ul>
          <li>Don't pick up a severely injured animal without proper support — you may worsen fractures</li>
          <li>Don't give any food, water or human medication without vet guidance</li>
          <li>Don't hold the animal tightly — fear can cause biting or scratching</li>
          <li>Don't leave a rescued animal unattended near a road</li>
          <li>Don't delay calling a vet — time is critical for injured animals</li>
          <li>Don't attempt to set broken bones or dress deep wounds yourself</li>
        </ul>
      </div>
    </div>

    <div class="rescue-content" id="adoption" role="tabpanel">
      <div class="stats-row">
        <div class="stat"><div class="stat-num">3.5Cr+</div><div class="stat-label">Street dogs in India</div></div>
        <div class="stat"><div class="stat-num">91%</div><div class="stat-label">Never find a home</div></div>
        <div class="stat"><div class="stat-num">1 in 7</div><div class="stat-label">People prefer adopted pets</div></div>
        <div class="stat"><div class="stat-num">0</div><div class="stat-label">Adoption fee at shelters</div></div>
      </div>
      <!-- Adoption Filters -->
      <div class="adoption-filters" style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px;align-items:center;">
        <select id="adoptFilterSpecies" onchange="filterAdoptions()" aria-label="Filter by species" style="padding:8px 14px;border-radius:var(--radius);border:1.5px solid var(--surface-dim);font-weight:600;font-family:var(--font);background:var(--surface);">
          <option value="">🐾 All Species</option>
          <option value="Dog">🐶 Dog</option>
          <option value="Cat">🐱 Cat</option>
          <option value="Bird">🐦 Bird</option>
          <option value="Cow">🐮 Cow</option>
          <option value="Other">Other</option>
        </select>
        <input id="adoptFilterLocation" placeholder="🔍 Filter by location..." oninput="filterAdoptions()" aria-label="Filter by location" style="padding:8px 14px;border-radius:var(--radius);border:1.5px solid var(--surface-dim);font-family:var(--font);min-width:160px;background:var(--surface);" />
      </div>
      <div class="adoption-grid" id="adoptionGrid"></div>
      <div style="margin-top:18px; display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
        <button class="btn-primary" onclick="openListingModal()">+ Add Listing</button>
        <span style="color:var(--text-muted); font-size:0.92rem;">Create adoption listings with photos and contact info.</span>
      </div>
    </div>
  </div>
</section>

<!-- FEEDING GUIDE -->
<section id="feeding" aria-label="Feeding guide for street animals">
  <div class="container reveal">
    <div class="section-label">🍖 Care & Feeding</div>
    <h2>Feeding Guide</h2>
    <p class="section-sub">Know what to feed (and what not to!) for each type of street animal. Small acts of kindness make a huge difference.</p>

    <div class="feeding-tabs" id="feedingTabs" role="tablist">
      <button class="feeding-tab active" onclick="switchFeed('dog', this)" role="tab" aria-selected="true">🐶 Dog</button>
      <button class="feeding-tab" onclick="switchFeed('cat', this)" role="tab" aria-selected="false">🐱 Cat</button>
      <button class="feeding-tab" onclick="switchFeed('cow', this)" role="tab" aria-selected="false">🐮 Cow</button>
      <button class="feeding-tab" onclick="switchFeed('bird', this)" role="tab" aria-selected="false">🐦 Bird</button>
      <button class="feeding-tab" onclick="switchFeed('monkey', this)" role="tab" aria-selected="false">🐒 Monkey</button>
    </div>

    <div id="feedingDisplay"></div>
  </div>
</section>

<!-- DONATE -->
<section id="donate" aria-label="Donate and support animal welfare">
  <div class="container reveal">
    <div class="section-label">🎁 Support</div>
    <h2>Donate & Support</h2>
