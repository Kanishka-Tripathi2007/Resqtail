<!-- CHATBOT -->
<button class="chat-trigger" onclick="toggleChat()" aria-label="Open ResQBot AI assistant">🐾</button>
<div class="chat-window" id="chatWindow" role="dialog" aria-label="ResQBot AI chat">
  <div class="chat-header">
    <div class="chat-avatar">🐾</div>
    <div class="chat-header-info">
      <h4>ResQBot</h4>
      <p>Street Animal AI Assistant</p>
    </div>
    <div class="chat-status">
      <div class="chat-dot"></div>
      <span>Online</span>
    </div>
    <button class="close-chat" onclick="toggleChat()" aria-label="Close chat">✕</button>
  </div>
  <div class="chat-messages" id="chatMessages">
    <div class="msg bot">
      <div class="msg-avatar">🐾</div>
      <div>
        <div class="msg-bubble">
          Hi! I'm ResQBot 🐾 I'm here to help you with street animal care, first aid, nearby vets, and more. How can I help today?
        </div>
        <div class="chat-quick-btns">
          <button class="quick-btn" onclick="sendQuickMsg('Dog hit by vehicle — what to do?')">🚗 Dog hit by vehicle</button>
          <button class="quick-btn" onclick="sendQuickMsg('First aid for injured bird')">🐦 Injured bird</button>
          <button class="quick-btn" onclick="sendQuickMsg('Abandoned puppy care tips')">🐶 Abandoned puppy</button>
          <button class="quick-btn" onclick="sendQuickMsg('How to treat a cow wound')">🐮 Cow wound care</button>
          <button class="quick-btn" onclick="sendQuickMsg('What not to feed cats')">🐱 Cat food safety</button>
          <button class="quick-btn" onclick="sendQuickMsg('Find nearby vet')">🏥 Find vet</button>
        </div>
      </div>
    </div>
  </div>
  <div class="chat-disclaimer" role="note">
    ⚠️ AI advice is not a replacement for a veterinarian. Contact a vet or rescuer in emergencies.
  </div>
  <div class="chat-input-area">
    <input class="chat-input" id="chatInput" placeholder="Ask about any street animal..." onkeydown="if(event.key==='Enter') sendChat()" aria-label="Type your message to ResQBot" />
    <button class="chat-send" onclick="sendChat()" aria-label="Send message">➤</button>
  </div>
</div>

