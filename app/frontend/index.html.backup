</section>

<!-- REPORT -->
<section id="report" aria-label="Report an injured animal">
  <div class="container reveal">
    <div class="section-label">📢 Report</div>
    <h2>Report an Animal in Need</h2>
    <p class="section-sub">See an injured or distressed animal? Report it and our network of NGOs and volunteers will respond.</p>
    <div class="report-form">
      <!-- Step progress indicator -->
      <div class="report-progress" aria-label="Report form progress">
        <div class="report-step active">
          <div class="report-step-num">1</div>
          <div class="report-step-line"></div>
        </div>
        <div class="report-step">
          <div class="report-step-num">2</div>
          <div class="report-step-line"></div>
        </div>
        <div class="report-step">
          <div class="report-step-num">3</div>
          <div class="report-step-line"></div>
        </div>
        <div class="report-step">
          <div class="report-step-num">4</div>
          <div class="report-step-line"></div>
        </div>
        <div class="report-step">
          <div class="report-step-num">5</div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="reportAnimal">Animal Type *</label>
          <select id="reportAnimal" aria-required="true">
            <option value="">Select Animal</option>
            <option>🐶 Dog</option>
            <option>🐱 Cat</option>
            <option>🐮 Cow</option>
            <option>🐦 Bird</option>
            <option>🐒 Monkey</option>
            <option>Other</option>
          </select>
        </div>
        <div class="form-group">
          <label for="reportUrgency">Urgency Level *</label>
          <select id="reportUrgency" aria-required="true">
            <option value="">Select Level</option>
            <option>🔴 Critical – Needs immediate help</option>
            <option>🟠 Moderate – Injured but stable</option>
            <option>🟡 Low – Stray, needs shelter</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label for="reportLocation">Location / Address *</label>
        <input type="text" id="reportLocation" placeholder="Enter address or click to auto-detect..." onclick="autoFillReportLocation()" aria-required="true" />
        <span class="helper-text">Click the field to auto-detect your GPS location</span>
        <input type="hidden" id="reportLat" />
        <input type="hidden" id="reportLng" />
      </div>
      <div class="form-group">
        <label for="reportDesc">Description</label>
        <textarea id="reportDesc" placeholder="Describe the animal's condition, what happened, any visible injuries..."></textarea>
      </div>
      <div class="form-group">
        <label for="photoUpload">Upload Photo</label>
        <div class="upload-zone" onclick="document.getElementById('photoUpload').click()" role="button" tabindex="0" aria-label="Click to upload a photo">
          <div class="icon">📷</div>
          <p>Click to upload a photo of the animal</p>
          <span class="helper-text" style="display:block;margin-top:6px;">Upload a clear photo if it is safe to do so</span>
          <input type="file" id="photoUpload" accept="image/*" style="display:none" onchange="handlePhotoUpload(this)" aria-label="Photo file input" />
        </div>
        <div id="photoPreview" class="photo-preview" style="display:none;"></div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="reportName">Your Name (optional)</label>
          <input type="text" id="reportName" placeholder="Name" />
        </div>
        <div class="form-group">
          <label for="reportEmail">Your Email (optional)</label>
          <input type="email" id="reportEmail" placeholder="Email" />
        </div>
      </div>
      <div class="form-group">
        <label for="reportContact">Your Contact Phone (optional)</label>
        <input type="text" id="reportContact" placeholder="Phone or WhatsApp number" />
      </div>
      <button class="submit-btn" onclick="submitReport()" aria-label="Submit report to nearby NGOs and volunteers">📢 Submit Report to Nearby NGOs & Volunteers</button>
    </div>
  </div>
</section>

