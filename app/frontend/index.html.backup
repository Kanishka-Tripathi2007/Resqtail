        <button class="btn-primary" onclick="openDonateModal()" style="background:var(--primary);">💳 Donate via Card / UPI</button>
        <span style="color:rgba(255,255,255,0.45); font-size:0.88rem;">Or choose one of the NGOs below to donate directly via UPI or website.</span>
      </div>
      <div class="ngo-donate-grid">
