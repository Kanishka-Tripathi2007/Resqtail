      <button class="donate-tab" onclick="switchDonateTab('items', this)" role="tab" aria-selected="false">🍚 Food & Items</button>
      <button class="donate-tab" onclick="switchDonateTab('volunteer', this)" role="tab" aria-selected="false">🙋 Volunteer</button>
