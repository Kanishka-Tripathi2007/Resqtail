        <button class="donate-loc-btn" id="itemsLocBtn" onclick="scanNearbyDonation('items')" aria-label="Scan my area for donation drop-off points">🛰️ Scan My Area</button>
      </div>
      <div id="itemsLiveResults"></div>
      <p class="donate-panel-desc">Drop off food, medicines and supplies at these verified centres. Every item helps keep street animals fed, healthy and cared for.</p>
      <div class="items-what-grid">
