<!-- DONATION MODAL -->
<div class="modal-overlay" id="donationModal">
  <div class="modal">
    <h3>💳 Donate to ResQtail</h3>
    <div id="donationBody" style="display:flex;flex-direction:column;gap:8px;">
      <label for="donationNgo">NGO</label>
      <select id="donationNgo" aria-label="Select NGO">
        <option>Go Nirvana Foundation</option>
        <option>Jaipur Animal Welfare Association</option>
        <option>Friendicoes SECA</option>
        <option>People for Animals (PFA)</option>
        <option>Blue Cross of India</option>
        <option>Wildlife SOS India</option>
        <option>ResQtail General Fund</option>
      </select>
      <label for="donationAmount">Amount (INR)</label>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <button type="button" class="quick-amount" onclick="setDonationAmount(100)">₹100</button>
        <button type="button" class="quick-amount" onclick="setDonationAmount(500)">₹500</button>
        <button type="button" class="quick-amount" onclick="setDonationAmount(1000)">₹1000</button>
        <button type="button" class="quick-amount" onclick="setDonationAmount(2500)">₹2500</button>
      </div>
      <input id="donationAmount" type="number" min="1" value="100" aria-label="Donation amount" />
      <label for="donationName">Name (optional)</label>
      <input id="donationName" type="text" aria-label="Donor name" />
      <label for="donationEmail">Email (optional)</label>
      <input id="donationEmail" type="email" aria-label="Donor email" />
      <label for="donationPhone">Phone (optional)</label>
      <input id="donationPhone" type="text" aria-label="Donor phone" />
      <label for="donationMessage">Message (optional)</label>
      <textarea id="donationMessage" placeholder="Leave a kind message for the NGO..." rows="2" aria-label="Message for NGO"></textarea>
      <div style="display:flex;gap:10px;margin-top:8px;">
        <button class="submit-btn" onclick="startDonation()">💳 Donate Now</button>
        <button class="modal-close" onclick="closeDonationModal()">Cancel</button>
      </div>
    </div>
  </div>
</div>

<!-- TOASTS -->
<div id="toastContainer" aria-live="polite" aria-atomic="true" class="toast-container"></div>

<!-- Razorpay checkout -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script src="app.js"></script>
<script src="nearby.js"></script>
</body>
</html>
