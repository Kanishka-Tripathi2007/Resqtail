        <div class="impact-desc">Emergency food for 5 animals</div>
      </div>
      <div class="impact-card" onclick="setDonationAmount(250);openDonateModal()" role="button" tabindex="0" aria-label="Donate 250 rupees for first aid supplies">
        <div class="impact-amount">₹250</div>
        <div class="impact-desc">First aid supplies</div>
      </div>
      <div class="impact-card" onclick="setDonationAmount(500);openDonateModal()" role="button" tabindex="0" aria-label="Donate 500 rupees for rescue transport">
        <div class="impact-amount">₹500</div>
        <div class="impact-desc">Rescue transport support</div>
      </div>
      <div class="impact-card" onclick="openDonateModal()" role="button" tabindex="0" aria-label="Donate a custom amount">
        <div class="impact-amount">Custom</div>
        <div class="impact-desc">Choose your own amount</div>
      </div>
