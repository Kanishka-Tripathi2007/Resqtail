[debug] [2026-05-10T10:42:29.765Z] <<< [apiv2][status] POST https://cloudaicompanion.googleapis.com/v1beta/projects/resqtail-0102/locations/global/instances/default:completeTask 200
[debug] [2026-05-10T10:42:29.765Z] <<< [apiv2][body] POST https://cloudaicompanion.googleapis.com/v1beta/projects/resqtail-0102/locations/global/instances/default:completeTask {"output":{"messages":[{"content":"```graphql\nmutation CreateUserReport($animalType: String!, $conditionDescription: String!, $latitude: Float!, $longitude: Float!, $photoUrl: String) @auth(level: USER) {\n  animalReport_insert(data: {\n    animalType: $animalType,\n    conditionDescription: $conditionDescription,\n    latitude: $latitude,\n    longitude: $longitude,\n    photoUrl: $photoUrl,\n    status: \"Pending\",\n    createdAt_expr: \"request.time\",\n    reporterId_expr: \"auth.uid\"\n  })\n}\n\nquery GetAnimalReportsByUser @auth(level: USER) {\n  animalReports(where: {reporterId: {eq_expr: \"auth.uid\"}}, orderBy: [{createdAt: DESC}]) {\n    id\n    animalType\n    conditionDescription\n    latitude\n    longitude\n    status\n    createdAt\n    photoUrl\n    lastSeenAt\n  }\n}\n\nquery GetAllRescueOrganizations @auth(level: PUBLIC, insecureReason: \"This operation is safe to expose to the public\") {\n  rescueOrganizations {\n    id\n    name\n    contactEmail\n    contactPhone\n    website\n    serviceArea\n    createdAt\n  }\n}\n\nmutation AssignReportToOrganization($reportId: UUID!, $organizationId: UUID!) @auth(level: USER, insecureReason: \"This operation is safe to expose to all logged in users.\") {\n  reportAssignment_insert(data: {\n    animalReportId: $reportId,\n    rescueOrganizationId: $organizationId,\n    status: \"Assigned\",\n    assignedAt_expr: \"request.time\"\n  })\n}\n```","author":"model"}]},"outputDataContext":{"additionalContext":{"@type":"type.googleapis.com/google.cloud.cloudaicompanion.v1main.ChatOutputDataContext","relatedContent":{}}},"attributionContext":{"citationMetadata":{}}}
